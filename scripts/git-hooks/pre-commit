#!/bin/bash
# 커밋 직전 게이트: 서식 + release 빌드(경고를 에러로 취급).
#
# 왜 release 빌드인가: [weak self]를 Task 안에서 바로 닿은 코드는 debug 빌드가
# 통과하고 release 빌드만 실패했다. 로컬에서 못 보고 CI에서 빨간 걸 본 부류다.
#
# 왜 스테이징 파일이 아니라 Sources 전체를 보는가: 한 파일의 일부만 staged 하면
# 파일 전체 서식을 검사할 수 없어서다. git add -p 로 잘라 넣은 커밋에서는 이 훅이
# 워킹 트리 전체 기준으로 판단하니 주의.
#
# 우회: --no-verify. 같은 검사는 Actions(build.yml)에도 거울로 있어서 PR 에서 막힌다.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

# 한국어/영어 저장소에 중국어 간체자가 섞여 들어온 적이 있다 (주석·문서에서 3회).
# 정당한 한자 사용도 가능하므로 막지 않고 알리기만 한다. 워킹 트리 내용을 본다.
text=$(printf '%s\n' "$staged" | grep -E '\.(swift|md|sh|json|yml|h|c)$' || true)
if [ -n "$text" ]; then
    # shellcheck disable=SC2086
    cjk=$(perl -CSD -ne 'print "$ARGV:$.: $_" if /[\x{4e00}-\x{9fff}]/; close ARGV if eof' $text 2>/dev/null || true)
    if [ -n "$cjk" ]; then
        echo "pre-commit: 중국어 한자가 발견됐다. 의도한 게 아니면 고치세요."
        printf '%s\n' "$cjk" | head -5
    fi
fi

if ! printf '%s\n' "$staged" | grep -qE '\.swift$'; then
    exit 0
fi

echo "pre-commit: swift-format 검사"
if ! swift format lint -r -p --strict Sources; then
    echo
    echo "서식이 맞지 않습니다. 다음을 실행한 뒤 다시 커밋하세요."
    echo "  swift format -r -i Sources"
    exit 1
fi

echo "pre-commit: release 빌드"
if ! swift build -c release -Xswiftc -warnings-as-errors; then
    echo
    echo "빌드 실패. debug 만으로는 모르고 넘어가는 에러가 있습니다."
    exit 1
fi
